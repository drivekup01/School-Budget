// One committed journal row owns both sides. No duplicate debit/credit writes.
const BORROWING_SHEET='ทะเบียนยืมงบประมาณ';
const BUDGET_TYPES=['เงินอุดหนุนรายหัว','เงินกิจกรรมพัฒนาผู้เรียน','เงินรายได้สถานศึกษา','อื่น ๆ'];
function registerTypes_(year){const key='register-types-'+budgetYear_(year),cache=CacheService.getScriptCache();let text=cache.get(key);if(!text){text=UrlFetchApp.fetch(BUDGET_APP+(Number(year)===2570?'budget-register-types-2570.json':'budget-register-types.json')).getContentText();cache.put(key,text,300);}return JSON.parse(text).projects;}
function borrowingSheet_(year,create){const book=SpreadsheetApp.openById((budgetYear_(year)===2570?WORKBOOKS_2570:WORKBOOKS)[0]);let sheet=book.getSheetByName(BORROWING_SHEET);if(!sheet&&create){sheet=book.insertSheet(BORROWING_SHEET);sheet.getRange(1,1,1,13).setValues([['รหัสรายการ','วันเวลาบันทึก','ประเภท','เลขเอกสาร','วันที่','ต้นทาง','ปลายทาง','ประเภทงบประมาณ','จำนวนเงิน','เหตุผล','ผู้บันทึก','อ้างอิงรายการเดิม','ข้อมูลรายการ']]);sheet.setFrozenRows(1);sheet.getRange(1,1,1,13).setBackground('#eee4fa').setFontWeight('bold');sheet.getRange('I:I').setNumberFormat('#,##0.00');sheet.setColumnWidth(13,140);}return sheet;}
function borrowingRecords_(year){const sheet=borrowingSheet_(year,false);if(!sheet||sheet.getLastRow()<2)return [];return sheet.getRange(2,13,sheet.getLastRow()-1,1).getValues().map(r=>{try{return JSON.parse(r[0])}catch{throw Error('ทะเบียนยืมมีข้อมูลเสียหาย กรุณาตรวจสอบก่อนทำรายการ');}});}
function borrowingDelta_(records,id,index){let incoming=0,outgoing=0;for(const record of records){const sign=record.kind==='cancel'?-1:1;if(record.source.projectId===Number(id)&&record.source.blockIndex===index)outgoing+=sign*record.amount;if(record.destination.projectId===Number(id)&&record.destination.blockIndex===index)incoming+=sign*record.amount;}return {incoming:Math.round(incoming*100)/100,outgoing:Math.round(outgoing*100)/100};}
function enrichBudgetRegister_(state){const records=borrowingRecords_(state.year),types=registerTypes_(state.year)[state.projectId]||[];state.blocks.forEach((b,i)=>{const delta=borrowingDelta_(records,state.projectId,i);b.blockIndex=i;b.budgetType=types.length===state.blocks.length?types[i].budgetType:null;b.activity=types.length===state.blocks.length?types[i].activity:null;b.ledgerCurrent=b.current;b.incoming=delta.incoming;b.outgoing=delta.outgoing;b.current=b.current===null?null:Math.round((b.current+delta.incoming-delta.outgoing)*100)/100;});state.borrowing=records.filter(r=>r.source.projectId===state.projectId||r.destination.projectId===state.projectId);state.revision=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,state.revision+JSON.stringify(state.borrowing)));return state;}
function borrowingDate_(value){if(!/^\d{4}-\d{2}-\d{2}$/.test(value||''))throw Error('วันที่ไม่ถูกต้อง');const date=Utilities.parseDate(value+' 12:00','Asia/Bangkok','yyyy-MM-dd HH:mm');if(Utilities.formatDate(date,'Asia/Bangkok','yyyy-MM-dd')!==value)throw Error('วันที่ไม่ถูกต้อง');return date;}
function borrowingEndpoint_(state,index){if(index===''||!Number.isInteger(Number(index)))throw Error('กรุณาเลือกทะเบียน');const b=state.blocks[Number(index)];if(!b||!b.budgetType||!BUDGET_TYPES.includes(b.budgetType)||b.current===null)throw Error('ทะเบียนนี้ยังไม่มีประเภทงบหรือยอดตั้งต้นที่ตรวจสอบได้');return {projectId:state.projectId,blockIndex:b.blockIndex,headerRow:b.headerRow,name:state.sheetName,activity:b.activity,budgetType:b.budgetType,received:b.received,sheetUrl:state.sheetUrl};}
function appendBorrowing_(year,record){const sheet=borrowingSheet_(year,true);sheet.getRange(sheet.getLastRow()+1,1,1,13).setValues([[record.id,new Date(record.createdAt),record.kind==='cancel'?'ยกเลิกการยืม':'ยืมงบประมาณ',safeText_(record.number,80),borrowingDate_(record.date),safeText_(record.source.name+(record.source.activity?' / '+record.source.activity:''),300),safeText_(record.destination.name+(record.destination.activity?' / '+record.destination.activity:''),300),record.budgetType,record.amount,safeText_(record.reason,500),record.userId,record.referenceId||'',JSON.stringify(record)]]);SpreadsheetApp.flush();}
function saveBudgetBorrowingLegacy_(input,token){const user=requireBudgetAdmin_(token),year=budgetYear_(input.year);const lock=LockService.getScriptLock();lock.waitLock(20000);try{
 if(!/^[a-zA-Z0-9-]{16,80}$/.test(input.requestId||''))throw Error('รหัสรายการไม่ถูกต้อง');
 const amount=Number(input.amount);if(!Number.isFinite(amount)||amount<=0||Math.abs(amount*100-Math.round(amount*100))>0.00001)throw Error('จำนวนเงินต้องมากกว่า 0 และมีทศนิยมไม่เกิน 2 ตำแหน่ง');
 const number=String(input.number||'').trim(),reason=String(input.reason||'').trim();if(!number||!reason||number.length>80||reason.length>500)throw Error('กรุณากรอกเลขเอกสารและเหตุผลให้ครบ');borrowingDate_(input.date);
 const fingerprint=JSON.stringify([year,Number(input.sourceProjectId),Number(input.sourceBlockIndex),Number(input.destinationProjectId),Number(input.destinationBlockIndex),amount,number,input.date,reason]);
 const records=borrowingRecords_(year),replay=records.find(r=>r.id===input.requestId);if(replay){if(replay.fingerprint!==fingerprint||replay.userId!==user.id)throw Error('รหัสรายการนี้ถูกใช้กับข้อมูลอื่นแล้ว');return replay;}
 const source=readRegister_(input.sourceProjectId,year),destination=Number(input.sourceProjectId)===Number(input.destinationProjectId)?source:readRegister_(input.destinationProjectId,year);
 if(source.revision!==input.sourceRevision||destination.revision!==input.destinationRevision)throw Error('ยอดมีการเปลี่ยนแปลง กรุณาโหลดข้อมูลล่าสุดก่อนบันทึก');
 const from=borrowingEndpoint_(source,input.sourceBlockIndex),to=borrowingEndpoint_(destination,input.destinationBlockIndex);
 if(from.projectId===to.projectId&&from.blockIndex===to.blockIndex)throw Error('ต้นทางและปลายทางต้องเป็นคนละทะเบียน');if(from.budgetType!==to.budgetType)throw Error('ต้องยืมจากประเภทงบเดียวกัน');
 const sb=source.blocks[from.blockIndex],db=destination.blocks[to.blockIndex];if(amount>sb.current)throw Error('ยอดคงเหลือต้นทางไม่เพียงพอ');
 const record={id:input.requestId,kind:'borrow',year:year,source:from,destination:to,budgetType:from.budgetType,amount:amount,number:number,date:input.date,reason:reason,userId:user.id,createdAt:new Date().toISOString(),fingerprint:fingerprint,sourceBefore:sb.current,sourceAfter:Math.round((sb.current-amount)*100)/100,destinationBefore:db.current,destinationAfter:Math.round((db.current+amount)*100)/100};
 appendBorrowing_(year,record);return record;
 }finally{lock.releaseLock();}}
function cancelBudgetBorrowingLegacy_(input,token){const user=requireBudgetAdmin_(token),year=budgetYear_(input.year),lock=LockService.getScriptLock();lock.waitLock(20000);try{const records=borrowingRecords_(year),original=records.find(r=>r.id===input.id&&r.kind==='borrow');if(!original)throw Error('ไม่พบรายการยืม');const replay=records.find(r=>r.kind==='cancel'&&r.referenceId===original.id);if(replay)return replay;
 const target=readRegister_(original.destination.projectId,year),block=target.blocks[original.destination.blockIndex];if(!block||block.current===null||Math.round((block.current-original.amount)*100)/100<Math.min(0,original.destinationBefore))throw Error('ปลายทางมียอดไม่พอคืนรายการนี้ กรุณาตรวจรายการใช้เงินก่อนยกเลิก');
 const record=Object.assign({},original,{id:Utilities.getUuid(),kind:'cancel',referenceId:original.id,userId:user.id,createdAt:new Date().toISOString(),reason:'ยกเลิกการยืม: '+original.reason});appendBorrowing_(year,record);return record;
 }finally{lock.releaseLock();}}
// Public totals only; never disclose documents, transaction reasons or account IDs.
function getBudgetAdjustmentSummaryLegacy_(year){year=budgetYear_(year);const records=borrowingRecords_(year),projects={};for(const r of records){const i=BUDGET_TYPES.indexOf(r.budgetType);if(i<0)throw Error('ประเภทงบในทะเบียนยืมไม่ถูกต้อง');const sign=r.kind==='cancel'?-1:1;for(const side of ['source','destination']){const endpoint=r[side],key=String(endpoint.projectId);if(!projects[key])projects[key]={delta:[0,0,0,0],blocks:{}};projects[key].delta[i]=Math.round((projects[key].delta[i]+sign*r.amount*(side==='source'?-1:1))*100)/100;const blockKey=String(endpoint.blockIndex);if(!projects[key].blocks[blockKey])projects[key].blocks[blockKey]={delta:0,activity:endpoint.activity,budgetType:r.budgetType};projects[key].blocks[blockKey].delta=Math.round((projects[key].blocks[blockKey].delta+sign*r.amount*(side==='source'?-1:1))*100)/100;}}
 for(const id of Object.keys(projects)){const state=readRegister_(Number(id),year);projects[id].receipts=BUDGET_TYPES.map(type=>{const blocks=state.blocks.filter(b=>b.budgetType===type&&b.received!==null);return blocks.length?Math.round(blocks.reduce((sum,b)=>sum+b.received,0)*100)/100:null;});projects[id].current=BUDGET_TYPES.map(type=>{const blocks=state.blocks.filter(b=>b.budgetType===type&&b.current!==null);return blocks.length?Math.round(blocks.reduce((sum,b)=>sum+b.current,0)*100)/100:null;});}
 return {year:year,projects:projects};}
