/* Account verifiers live in Script Properties, never in the public repository. */
function authUsers_(){const rows=SpreadsheetApp.openById('1gDQDWTbkTSRz2iYPz2TXbuXYxqt6-nxeJdmAbJkptcY').getSheetByName('Accounts').getDataRange().getValues().slice(1);const users={};for(const row of rows)if(row[0])users[String(row[0])]={name:String(row[1]),role:String(row[2]),salt:String(row[3]),verifier:String(row[4])};return users;}
function authHex_(bytes){return bytes.map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function authBytes_(hex){if(!/^[0-9a-f]{64}$/.test(hex))throw Error('ข้อมูลยืนยันไม่ถูกต้อง');return hex.match(/../g).map(v=>{const n=parseInt(v,16);return n>127?n-256:n});}
function authDigest_(value){return authHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value)));}
function authAttempts_(id){const cache=CacheService.getScriptCache(),key='auth-attempt-'+authDigest_(id);if(Number(cache.get(key)||0)>=5)throw Error('เข้าสู่ระบบผิดหลายครั้ง กรุณารอ 5 นาที');return {cache:cache,key:key};}
function createLoginChallenge(id){id=String(id||'').trim().toLowerCase();if(!/^[a-z0-9._-]{1,80}$/.test(id))throw Error('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');authAttempts_(id);const users=authUsers_(),user=users[id];const challengeId=Utilities.getUuid(),nonce=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('auth-challenge-'+challengeId,JSON.stringify({id:id,nonce:nonce}),120);return {challengeId:challengeId,nonce:nonce,salt:user?user.salt:authDigest_(id).slice(0,32),iterations:150000};}
function completeLogin(challengeId,proof){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const cache=CacheService.getScriptCache(),key='auth-challenge-'+String(challengeId),raw=cache.get(key);cache.remove(key);if(!raw)throw Error('คำขอเข้าสู่ระบบหมดอายุ กรุณาลองใหม่');const challenge=JSON.parse(raw),attempt=authAttempts_(challenge.id),user=authUsers_()[challenge.id];const expected=user?authHex_(Utilities.computeHmacSha256Signature(Utilities.newBlob(challenge.nonce).getBytes(),authBytes_(user.verifier))):authDigest_(challenge.nonce);const actual=String(proof||'');let difference=expected.length^actual.length;for(let i=0;i<expected.length;i++)difference|=expected.charCodeAt(i)^(actual.charCodeAt(i)||0);if(!user||difference){attempt.cache.put(attempt.key,String(Number(attempt.cache.get(attempt.key)||0)+1),300);throw Error('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง')}attempt.cache.remove(attempt.key);const token=Utilities.getUuid()+Utilities.getUuid(),expires=Date.now()+4*60*60*1000,session={id:challenge.id,name:user.name,role:user.role,expires:expires};cache.put('auth-session-'+authDigest_(token),JSON.stringify(session),14400);return {token:token,user:session};}finally{lock.releaseLock();}}
function getBudgetUser(token){if(typeof token!=='string'||token.length<40||token.length>100)throw Error('กรุณาเข้าสู่ระบบ');const raw=CacheService.getScriptCache().get('auth-session-'+authDigest_(token));if(!raw)throw Error('กรุณาเข้าสู่ระบบใหม่');const user=JSON.parse(raw);if(user.expires<=Date.now())throw Error('กรุณาเข้าสู่ระบบใหม่');const account=authUsers_()[user.id];if(!account||account.role!==user.role||!['admin','editor'].includes(user.role))throw Error('ไม่มีสิทธิ์ใช้งานบัญชีนี้');return user;}
function requireBudgetAdmin_(token){const user=getBudgetUser(token);if(user.role!=='admin')throw Error('บัญชีนี้ดูข้อมูลงบประมาณได้อย่างเดียว');return user;}
function logoutBudgetUser(token){if(typeof token==='string')CacheService.getScriptCache().remove('auth-session-'+authDigest_(token));return true;}
function doPost(e){let output;try{const input=JSON.parse(e.postData.contents);if(input.action!=='document-session')throw Error('คำขอไม่ถูกต้อง');output={user:getBudgetUser(input.token)};}catch(error){output={error:error.message||String(error)}}return ContentService.createTextOutput(JSON.stringify(output)).setMimeType(ContentService.MimeType.JSON);}
