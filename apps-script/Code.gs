 window.addEventListener('message',e=>{const m=e.data;if(e.origin!==appOrigin||e.source!==window.top||m?.channel!=='school-budget'||!['getBudgetRegister','getBudgetDocumentFinance','saveBudgetEntry','mutateBudgetEntry','saveBudgetBorrowing','cancelBudgetBorrowing','getBudgetAdjustmentSummary','createLoginChallenge','completeLogin','getBudgetUser','logoutBudgetUser','getBudgetYearSnapshot','getBudgetYears','getBudgetImportHistory','publishBudgetYearImport','restoreBudgetYearImport'].includes(m.method)||!Array.isArray(m.args)||typeof m.requestId!=='string')return;
