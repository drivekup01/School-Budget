const WORKBOOKS_2570=['11jqvfm7_iEaQDsiXJIfQ5yZysWYSc9RBvB9WZZeStVU','1tCDiUiP5lF_vSyJIkCAPB-y0PWJGUjvOsp-2qhVf30M','14RDH54b7BD2QFsoKSP2vH8cBWzderCO9fNy0IkYb9xw','1aO9LqK9G8wD2T-5Oz7UO8RZ0UfPa41UVGBJpeSyIeLU'];
function budgetYear_(year){year=year==null?2569:Number(year);if(year!==2569&&year!==2570)throw Error('ปีงบประมาณไม่ถูกต้อง');return year;}
function doGet(e){if(e&&e.parameter&&e.parameter.bridge==='1')return budgetBridge_();const id=Number(e&&e.parameter&&e.parameter.project)||1;const year=budgetYear_(e&&e.parameter&&e.parameter.year);const html=UrlFetchApp.fetch(BUDGET_APP+'budget-entry.html').getContentText().replace('<head>','<head><base href="'+BUDGET_APP+'" target="_top"><script>window.budgetProjectId='+JSON.stringify(id)+';window.budgetYear='+year+';</script>');return HtmlService.createHtmlOutput(html).setTitle('บันทึกรายการงบประมาณ');}
function projectSheet_(id,year){year=budgetYear_(year);id=Number(id);if(!Number.isInteger(id)||id<1||id>39)throw Error('โครงการไม่ถูกต้อง');const index=id<=16?0:id<=18?1:id<=22?2:3;const book=SpreadsheetApp.openById((year===2570?WORKBOOKS_2570:WORKBOOKS)[index]);const sheet=book.getSheets().find(s=>new RegExp('^'+id+'\\.').test(s.getName()));if(!sheet)throw Error('ไม่พบแท็บโครงการ');return {book:book,sheet:sheet};}
function normalize_(value){return String(value||'').replace(/\s+/g,'').trim();}
function readRegister_(id,year){year=budgetYear_(year);const target=projectSheet_(id,year),sheet=target.sheet,values=sheet.getDataRange().getValues(),display=sheet.getDataRange().getDisplayValues();const headers=[];
 values.forEach((row,i)=>{if(normalize_(row[1])==='วันที่'&&normalize_(row[2])==='รายการ'&&normalize_(row[3]).includes('งบประมาณ')&&normalize_(row[4]).includes('เงินที่ใช้')&&normalize_(row[5])==='คงเหลือ')headers.push(i);});
 const blocks=headers.map((header,index)=>{const end=index+1<headers.length?headers[index+1]:values.length;let last=header,current=null,received=null,used=null;const entries=[];
  for(let i=header+1;i<end;i++){const row=values[i];if(typeof row[3]==='number'&&received===null)received=row[3];if(typeof row[5]==='number'&&(typeof row[4]==='number'||typeof row[3]==='number')){last=i;current=row[5];if(typeof row[7]==='number')used=row[7];}if(typeof row[4]==='number'&&String(row[2]||'').trim()){entries.push({row:i+1,number:display[i][0],date:display[i][1],description:display[i][2],spent:row[4],remaining:typeof row[5]==='number'?row[5]:null,note:display[i][6]||''});}}
  if(current===null&&received===null){const parent=values.slice(0,header).find(r=>Number(r[1])===Number(id));const amounts=parent?parent.slice(3,7).filter(v=>typeof v==='number'):[];if(amounts.length===1)received=amounts[0];}if(current===null&&received!==null)current=received;if(used===null)used=entries.reduce((n,e)=>n+e.spent,0);return {headerRow:header+1,lastRow:last+1,received:received,current:current,used:used,entries:entries};
 });const revision=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(values)));return enrichBudgetRegister_({year:year,projectId:Number(id),sheetName:sheet.getName(),sheetUrl:target.book.getUrl()+'#gid='+sheet.getSheetId(),blocks:blocks,revision:revision});}
function getBudgetRegister(id,year,token){if(token===undefined){token=year;year=2569;}getBudgetUser(token);return readRegister_(id,year);}
function safeText_(value,max){const text=String(value||'').trim();if(text.length>max)throw Error('ข้อความยาวเกินกำหนด');return /^[=+@-]/.test(text)?"'"+text:text;}
function saveBudgetEntry(input,token){requireBudgetAdmin_(token);const lock=LockService.getScriptLock();lock.waitLock(20000);try{
 const target=projectSheet_(input.projectId,input.year),sheet=target.sheet;if(!/^[a-zA-Z0-9-]{16,80}$/.test(input.requestId||''))throw Error('รหัสรายการไม่ถูกต้อง');const replay=sheet.getDeveloperMetadata().find(m=>m.getKey()==='budget-entry-'+input.requestId);if(replay)return JSON.parse(replay.getValue());
 const state=readRegister_(input.projectId,input.year);if(state.revision!==input.revision)throw Error('ยอดใน Sheet เปลี่ยนแล้ว กรุณาโหลดใหม่ก่อนบันทึก');const block=state.blocks.find(b=>b.headerRow===Number(input.headerRow));if(!block||block.current===null)throw Error('ชุดทะเบียนยังไม่มียอดตั้งต้น กรุณากำหนดยอดใน Sheet สำเนาก่อน');
 const spent=Number(input.spent);if(!Number.isFinite(spent)||spent<=0||Math.abs(spent*100-Math.round(spent*100))>0.00001)throw Error('จำนวนเงินต้องมากกว่า 0 และมีทศนิยมไม่เกิน 2 ตำแหน่ง');if(spent>block.current)throw Error('ยอดคงเหลือไม่เพียงพอ กรุณาเพิ่มการยืมเงินหรือปรับจำนวนเงิน');
 if(!/^\d{4}-\d{2}-\d{2}$/.test(input.date||''))throw Error('วันที่ไม่ถูกต้อง');const date=Utilities.parseDate(input.date+' 12:00','Asia/Bangkok','yyyy-MM-dd HH:mm');if(Utilities.formatDate(date,'Asia/Bangkok','yyyy-MM-dd')!==input.date)throw Error('วันที่ไม่ถูกต้อง');const number=safeText_(input.number,80),description=safeText_(input.description,500),note=safeText_(input.note,500);if(!number||!description)throw Error('กรุณากรอกเลขเอกสารและรายการ');
 const row=block.lastRow+1;if(sheet.getRange(row,1,1,8).getValues()[0].some(v=>v!==''))sheet.insertRowsBefore(row,1);sheet.getRange(block.lastRow,1,1,8).copyFormatToRange(sheet,1,8,row,row);sheet.getRange(row,1,1,8).setValues([[number,date,description,block.lastRow===block.headerRow?block.ledgerCurrent:'',spent,block.lastRow===block.headerRow?'=D'+row+'-E'+row:'=F'+block.lastRow+'-E'+row,note,'='+block.used+'+E'+row]]);sheet.getRange(row,2).setNumberFormat('dd mmm yyyy');sheet.getRange(row,5,1,2).setNumberFormat('#,##0.00');sheet.getRange(row,8).setNumberFormat('#,##0.00');if(!sheet.getRange(block.headerRow,8).getValue())sheet.getRange(block.headerRow,8).setValue('ใช้ไปทั้งหมด');SpreadsheetApp.flush();
 const result={row:row,remaining:Math.round((block.current-spent)*100)/100,used:Math.round((block.used+spent)*100)/100};sheet.addDeveloperMetadata('budget-entry-'+input.requestId,JSON.stringify(result));return result;
 }finally{lock.releaseLock();}}
function budgetBridge_(){
 const html=`<!doctype html><html><body><script>
 const appOrigin='https://drivekup01.github.io';
 window.addEventListener('message',e=>{const m=e.data;if(e.origin!==appOrigin||e.source!==window.top||m?.channel!=='school-budget'||!['getBudgetRegister','getBudgetDocumentFinance','saveBudgetEntry','saveBudgetBorrowing','cancelBudgetBorrowing','getBudgetAdjustmentSummary','createLoginChallenge','completeLogin','getBudgetUser','logoutBudgetUser'].includes(m.method)||!Array.isArray(m.args)||typeof m.requestId!=='string')return;
 const reply=payload=>e.source.postMessage(Object.assign({channel:'school-budget',requestId:m.requestId},payload),e.origin);
 google.script.run.withSuccessHandler(result=>reply({result})).withFailureHandler(error=>reply({error:error.message||String(error)}))[m.method](...m.args);
 });window.top.postMessage({channel:'school-budget',type:'ready'},appOrigin);
 </script></body></html>`;
 return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// Public form totals only. Never return ledger rows, notes, document numbers or workbook URLs.
function getBudgetDocumentFinance(id,year){const state=readRegister_(id,budgetYear_(year));return {year:state.year,projectId:state.projectId,revision:state.revision,blocks:state.blocks.map(b=>({budgetType:b.budgetType,received:b.received,used:b.used,current:b.current}))};}
