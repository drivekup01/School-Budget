[{"budgetType":"เงินกิจกรรมพัฒนาผู้เรียน","activity":null,"registerId":"P39-F2-R1","sourceHeaderRow":7}],"40":[{"budgetType":"เงินอุดหนุนรายหัว","activity":null,"registerId":"P40-F1-R1","sourceHeaderRow":7}]};
 const loans=borrowingRecords_(2570);
 for(const dept of config.departments){const book=SpreadsheetApp.openById(dept.spreadsheetId);for(const ref of dept.projectSheets){
  const p=base.projects.find(p=>p.id===ref.projectId);if(!p)throw Error('ไม่พบแผนโครงการ '+ref.projectId);
  const sheet=book.getSheetByName(ref.title);if(!sheet)throw Error('ไม่พบชีต '+ref.title);
  const rows=sheet.getDataRange().getValues(),headers=[];
  rows.forEach((r,i)=>{if(normalize_(r[1])==='วันที่'&&normalize_(r[2])==='รายการ'&&normalize_(r[5])==='คงเหลือ')headers.push(i);});
  const registers=types[p.id];if(headers.length!==registers.length)throw Error('จำนวนทะเบียนไม่ตรงโครงการ '+p.id);
  p.income=[0,0,0,0];p.remaining=[0,0,0,0];for(const a of p.activities){a.income=[0,0,0,0];a.remaining=[0,0,0,0];}
  headers.forEach((h,bi)=>{const meta=registers[bi],fi=BUDGET_TYPES.indexOf(meta.budgetType),end=bi+1<headers.length?headers[bi+1]:rows.length;let received=0,current=null;
   for(let r=h+1;r<end;r++){if(typeof rows[r][3]==='number')received+=rows[r][3];if(typeof rows[r][5]==='number'&&(typeof rows[r][3]==='number'||typeof rows[r][4]==='number'))current=rows[r][5];}
   if(fi<0||current===null)throw Error('ทะเบียนไม่มียอดตั้งต้นโครงการ '+p.id);
   const delta=borrowingDelta_(loans,p.id,bi);current=Math.round((current+delta.incoming-delta.outgoing)*100)/100;
   p.income[fi]=Math.round((p.income[fi]+received)*100)/100;p.remaining[fi]=Math.round((p.remaining[fi]+current)*100)/100;
   const a=p.activities.find(a=>a.name===meta.activity);if(a){a.income[fi]=Math.round((a.income[fi]+received)*100)/100;a.remaining[fi]=Math.round((a.remaining[fi]+current)*100)/100;}
  });
 }}
 for(const d of base.departments){const ps=base.projects.filter(p=>p.department===d.name);d.income=BUDGET_TYPES.map((_,i)=>Math.round(ps.reduce((s,p)=>s+p.income[i],0)*100)/100);d.remaining=BUDGET_TYPES.map((_,i)=>Math.round(ps.reduce((s,p)=>s+p.remaining[i],0)*100)/100);}
 base.snapshotDate=Utilities.formatDate(new Date(),'Asia/Bangkok','yyyy-MM-dd');return base;
}
function verifyPrimary2570(){if(importRevision_(2570)!=='legacy')throw Error('ปี2570 มีเวอร์ชันนำเข้าที่ใช้งานอยู่ ต้องตรวจประวัติก่อน');const data=primary2570Snapshot_();const total=data.projects.reduce((s,p)=>s+p.income.reduce((a,v)=>a+v,0),0);if(data.projects.length!==40||Math.abs(total-3246671.38)>.01)throw Error('ยอดไม่ผ่านการตรวจสอบ');console.log(JSON.stringify({projects:data.projects.length,total:total,year:data.year}));}
